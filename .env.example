# Environment variables used by astro.config.mjs
#
# Copy this file to `.env` and fill in values as needed for local development.

# Full canonical site URL (with protocol, no trailing slash) used to build
# the `site` config, which feeds the sitemap, RSS feeds, and canonical/OG URLs.
# Takes priority over VERCEL_PROJECT_PRODUCTION_URL below if both are set.
SITE_URL=https://startingfinanceclub.usi.ch

# Automatically injected by Vercel on real deployments as a bare hostname
# (no protocol) — https://vercel.com/docs/projects/environment-variables/system-environment-variables
# You normally don't need to set this yourself; it's only used as a fallback
# when SITE_URL isn't set.
VERCEL_PROJECT_PRODUCTION_URL=
