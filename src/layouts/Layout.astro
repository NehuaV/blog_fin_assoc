---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "Finance Association of Università della Svizzera italiana", ogImage } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader />
    <slot />

    <!-- Image zoom overlay.
         style="display:none" is set directly in HTML so the element is hidden
         before any JS or CSS runs — eliminates the one-frame flash on bfcache restore. -->
    <div class="zoom-overlay" id="zoom-overlay" style="display:none">
      <img alt="Zoomed image" id="zoom-img" src="" />
    </div>

    <script>
      const overlay = document.getElementById('zoom-overlay')!;
      const overlayImg = document.getElementById('zoom-img') as HTMLImageElement;

      function openZoom(img: HTMLImageElement) {
        overlayImg.src = img.currentSrc || img.src;
        overlayImg.alt = img.alt;
        overlay.style.display = '';   // lift the inline override so CSS takes over
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeZoom() {
        overlay.classList.remove('active');
        document.body.style.overflow = '';
        overlay.style.display = 'none'; // inline style is preserved by bfcache
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.matches('.zoomable-img')) {
          openZoom(target as HTMLImageElement);
        } else if (overlay.classList.contains('active')) {
          closeZoom();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeZoom();
      });

      // pagehide fires before the bfcache snapshot is taken.
      // Closing here ensures the snapshot always captures display:none.
      window.addEventListener('pagehide', closeZoom);

      // pageshow backstop: if the page is restored from bfcache and the overlay
      // somehow wasn't cleaned up, hide it instantly before the user sees anything.
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) closeZoom();
      });
    </script>
  </body>
</html>
