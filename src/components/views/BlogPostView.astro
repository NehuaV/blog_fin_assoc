---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { defaultLang } from "../../i18n/ui";
import { dateLocale, isLang, useTranslations } from "../../i18n/utils";

interface Props {
  entry: CollectionEntry<"blog">;
  lang?: string;
}

const { entry, lang: langProp } = Astro.props;
const lang = isLang(langProp) ? langProp : defaultLang;
const t = useTranslations(lang);
const { Content } = await render(entry);
---

<main class="max-w-3xl mx-auto px-8 py-16">
  <p class="text-[0.68rem] font-bold tracking-widest uppercase text-muted mb-3">
    {entry.data.category}
  </p>
  <h1
    class="font-black text-4xl md:text-5xl tracking-tight leading-[1.05] mb-4"
  >
    {entry.data.title}
  </h1>
  <p class="text-sm text-muted mb-8">
    {entry.data.author} ·
    <time datetime={entry.data.pubDate.toISOString()}>
      {
        entry.data.pubDate.toLocaleDateString(dateLocale(lang), {
          day: "numeric",
          month: "long",
          year: "numeric",
        })
      }
    </time>
  </p>

  <Image
    src={entry.data.coverImage}
    alt={entry.data.coverAlt || entry.data.title}
    width={800}
    class="zoomable-img w-full border-2 border-ink rounded-2xl mb-10 aspect-video object-cover"
    loading="eager"
  />

  <div
    id="blog-content"
    class="text-ink leading-relaxed
    [&_p]:mb-5
    [&_h2]:font-black [&_h2]:tracking-tight [&_h2]:text-2xl [&_h2]:mt-10 [&_h2]:mb-3
    [&_h3]:font-black [&_h3]:tracking-tight [&_h3]:text-xl [&_h3]:mt-8 [&_h3]:mb-2
    [&_a]:text-pink [&_a]:underline [&_a:hover]:text-ink
    [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-5
    [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-5
    [&_li]:mb-1
    [&_strong]:font-bold
    [&_code]:font-mono [&_code]:text-sm [&_code]:bg-ink/8 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded
    [&_pre]:bg-ink [&_pre]:text-paper [&_pre]:rounded-lg [&_pre]:p-4 [&_pre]:overflow-x-auto [&_pre]:mb-5
    [&_pre_code]:bg-transparent [&_pre_code]:p-0
    [&_blockquote]:border-l-4 [&_blockquote]:border-pink [&_blockquote]:pl-4 [&_blockquote]:text-muted [&_blockquote]:mb-5
    [&_table]:w-full [&_table]:mb-5
    [&_th]:text-left [&_th]:font-bold [&_th]:text-xs [&_th]:uppercase [&_th]:tracking-widest [&_th]:text-muted [&_th]:pb-2 [&_th]:border-b-2 [&_th]:border-ink
    [&_td]:py-2 [&_td]:border-b [&_td]:border-line
    [&_hr]:border-line [&_hr]:my-8
    [&_figure]:my-8
    [&_figcaption]:text-xs [&_figcaption]:text-muted [&_figcaption]:mt-2 [&_figcaption]:text-center"
  >
    <Content />
  </div>

  {
    entry.data.gallery.length > 0 && (
      <section
        class="mt-16 border-t-2 border-ink pt-10"
        aria-label="Photo gallery"
      >
        <p class="text-[0.68rem] font-bold tracking-widest uppercase text-muted mb-1">
          {t("blog.gallery")}
        </p>
        <h2 class="font-black text-2xl tracking-tight mb-6">
          {t("blog.photos")}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {entry.data.gallery.map((item) => (
            <figure class="m-0">
              <Image
                src={item.src}
                alt={item.alt}
                width={400}
                class="zoomable w-full border-2 border-ink rounded-xl aspect-video object-cover"
              />
              {item.caption && (
                <figcaption class="text-xs text-muted mt-2">
                  {item.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )
  }
</main>

<script>
  // Content-collection markdown images don't go through the rehype pipeline,
  // so we stamp the zoom class on them at runtime instead.
  document.querySelectorAll("#blog-content img").forEach((img) => {
    img.classList.add("zoomable-img");
  });
</script>
