---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang } from "../../i18n/ui";
import { dateLocale, isLang, useTranslations } from "../../i18n/utils";

interface Props {
  posts: CollectionEntry<"blog">[];
  lang?: string;
}

const { posts, lang: langProp } = Astro.props;
const lang = isLang(langProp) ? langProp : defaultLang;
const t = useTranslations(lang);

function postHref(id: string) {
  const slug = id.split("/").slice(1).join("/");
  return getRelativeLocaleUrl(lang, `blog/${slug}`);
}
---

<section class="bg-cream border-b-2 border-ink">
  <div class="max-w-6xl mx-auto px-6 sm:px-8">
    <div class="pt-14 pb-3 flex items-baseline gap-6 flex-wrap">
      <span
        class="text-[0.68rem] font-bold tracking-widest uppercase text-muted whitespace-nowrap"
      >
        {t("blog.insights")}
      </span>
      <h1 class="font-black text-3xl md:text-5xl tracking-tight leading-[1.05]">
        {t("blog.allPre")}
        {" "}
        <span class="text-blue">{t("blog.allAccent")}</span>
      </h1>
    </div>

    <div
      class="border-t-2 border-ink grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pt-8 pb-16"
    >
      {
        posts.map((post) => (
          <a
            href={postHref(post.id)}
            class="group bg-paper border-2 border-ink rounded-2xl p-7 flex flex-col transition-transform hover:-translate-y-1"
          >
            <p class="text-[0.68rem] font-bold tracking-widest uppercase text-muted mb-3">
              {post.data.category}
            </p>
            <Image
              src={post.data.coverImage}
              alt={post.data.coverAlt || post.data.title}
              width={400}
              class="w-full aspect-video object-cover rounded-lg mb-5"
            />
            <h2 class="font-black text-lg tracking-tight leading-snug mb-3">
              {post.data.title}
            </h2>
            <p class="text-sm text-ink/60 leading-relaxed mb-6">
              {post.data.description}
            </p>
            <div class="mt-auto flex justify-between items-center text-xs text-muted pt-4 border-t border-line">
              <span>
                {post.data.author} ·{" "}
                {post.data.pubDate.toLocaleDateString(dateLocale(lang), {
                  day: "numeric",
                  month: "short",
                  year: "numeric",
                })}
              </span>
              <span class="text-pink font-black">→</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
