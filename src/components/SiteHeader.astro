---
const { pathname } = Astro.url;

const isHome = pathname === "/";
const isBlog = pathname.startsWith("/blog");
---
<header class="sticky top-0 z-40 bg-paper border-b-2 border-ink">
  <nav class="max-w-6xl mx-auto px-6 sm:px-8 h-16 flex items-center justify-between">
    <a href="/" class="font-black text-sm tracking-tight text-ink hover:text-pink transition-colors">
      Starting Finance Club · <span class="text-pink">USI</span>
    </a>
    <ul class="flex gap-10 list-none m-0 p-0">
      <li>
        <a
          href="/"
          class:list={[
            'text-sm font-semibold transition-colors',
            isHome ? 'text-pink' : 'text-ink hover:text-pink',
          ]}
        >
          Home
        </a>
      </li>
      <li>
        <a
          href="/blog"
          class:list={[
            'text-sm font-semibold transition-colors',
            isBlog ? 'text-pink' : 'text-ink hover:text-pink',
          ]}
        >
          Blog
        </a>
      </li>
    </ul>
  </nav>
</header>
