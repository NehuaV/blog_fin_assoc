---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { defaultLang } from "../i18n/ui";
import { isLang, useTranslations } from "../i18n/utils";

const lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);

const { pathname } = Astro.url;
const localePrefix = lang === defaultLang ? "" : `/${lang}`;

const isHome =
  pathname === `${localePrefix}/` ||
  pathname === localePrefix ||
  pathname === "/";
const isBlog = pathname.startsWith(`${localePrefix}/blog`);

const homeHref = getRelativeLocaleUrl(lang, "");
const blogHref = getRelativeLocaleUrl(lang, "blog");
---

<header class="sticky top-0 z-40 bg-paper border-b-2 border-ink">
  <nav
    class="max-w-6xl mx-auto px-4 sm:px-8 h-16 flex items-center justify-between gap-4"
  >
    <a
      href={homeHref}
      class="font-black text-sm tracking-tight text-ink hover:text-pink transition-colors whitespace-nowrap shrink-0"
    >
      <span class="hidden sm:inline">Starting Finance Club · </span><span class="text-pink">USI</span>
    </a>
    <div class="flex items-center gap-3 sm:gap-8 shrink-0">
      <ul class="flex gap-4 sm:gap-10 list-none m-0 p-0">
        <li>
          <a
            href={homeHref}
            class:list={[
              "text-sm font-semibold transition-colors whitespace-nowrap",
              isHome ? "text-pink" : "text-ink hover:text-pink",
            ]}
          >
            {t("nav.home")}
          </a>
        </li>
        <li>
          <a
            href={blogHref}
            class:list={[
              "text-sm font-semibold transition-colors whitespace-nowrap",
              isBlog ? "text-pink" : "text-ink hover:text-pink",
            ]}
          >
            {t("nav.blog")}
          </a>
        </li>
      </ul>
      <LanguageSwitcher />
    </div>
  </nav>
</header>
