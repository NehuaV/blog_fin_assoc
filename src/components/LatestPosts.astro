---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const [featured, ...rest] = allPosts;
---
<section id="blog" class="bg-cream border-b-2 border-ink">
  <div class="px-8 md:px-[5%] pt-14 pb-3 flex items-baseline gap-6 flex-wrap">
    <span class="text-[0.68rem] font-bold tracking-[0.12em] uppercase text-muted whitespace-nowrap">
      Insights
    </span>
    <h2 class="font-black text-3xl md:text-5xl tracking-tight leading-[1.05]">
      Latest <span class="text-blue">posts.</span>
    </h2>
  </div>

  <div class="border-t-2 border-ink grid grid-cols-1 md:grid-cols-3 gap-8 px-8 md:px-[5%] pt-8 pb-16">
    {featured && (
      <a
        href={`/blog/${featured.id}`}
        class="group md:col-span-2 bg-ink text-paper border-2 border-ink rounded-2xl p-7 flex flex-col transition-transform hover:-translate-y-1"
      >
        <p class="text-[0.68rem] font-bold tracking-widest uppercase text-pink mb-3">
          {featured.data.category} · Featured
        </p>
        <Image
          src={featured.data.coverImage}
          alt={featured.data.coverAlt || featured.data.title}
          width={700}
          class="zoomable-img w-full aspect-video object-cover rounded-lg mb-5"
        />
        <h3 class="font-black text-xl md:text-2xl tracking-tight leading-snug mb-3">
          {featured.data.title}
        </h3>
        <p class="text-sm text-white/70 leading-relaxed mb-6">{featured.data.description}</p>
        <div class="mt-auto flex justify-between items-center text-xs text-white/50 pt-4 border-t border-white/20">
          <span>{featured.data.author} · {featured.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
          <span class="text-pink font-black">→</span>
        </div>
      </a>
    )}

    {rest.map(post => (
      <a
        href={`/blog/${post.id}`}
        class="group bg-paper border-2 border-ink rounded-2xl p-7 flex flex-col transition-transform hover:-translate-y-1"
      >
        <p class="text-[0.68rem] font-bold tracking-widest uppercase text-muted mb-3">
          {post.data.category}
        </p>
        <Image
          src={post.data.coverImage}
          alt={post.data.coverAlt || post.data.title}
          width={400}
          class="zoomable-img w-full aspect-video object-cover rounded-lg mb-5"
        />
        <h3 class="font-black text-lg tracking-tight leading-snug mb-3">
          {post.data.title}
        </h3>
        <p class="text-sm text-ink/60 leading-relaxed mb-6">{post.data.description}</p>
        <div class="mt-auto flex justify-between items-center text-xs text-muted pt-4 border-t border-line">
          <span>{post.data.author}</span>
          <span class="text-pink font-black">→</span>
        </div>
      </a>
    ))}
  </div>
</section>
