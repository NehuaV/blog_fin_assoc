---
import { getCollection } from "astro:content";
import { defaultLang } from "../i18n/ui";
import { isLang, useTranslations } from "../i18n/utils";

const lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);

const startOfToday = new Date();
startOfToday.setHours(0, 0, 0, 0);

const events = (await getCollection("events"))
  .filter((event) => event.id.startsWith(`${lang}/`))
  .filter((event) => event.data.date >= startOfToday)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const dayColors = ["text-pink", "text-green", "text-blue"];

const tagColors: Record<string, string> = {
  Workshop: "text-blue border-blue",
  "Speaker Talk": "text-green border-green",
  Competition: "text-pink border-pink",
  "Company Visit": "text-muted border-muted",
};
const defaultTagColor = "text-muted border-muted";
---

{
  events.length > 0 && (
    <section id="events" class="bg-paper border-b-2 border-ink">
      <div class="max-w-6xl mx-auto px-6 sm:px-8">
        <div class="pt-14 pb-3 flex items-baseline gap-6 flex-wrap">
          <span class="text-[0.68rem] font-bold tracking-[0.12em] uppercase text-muted whitespace-nowrap">
            {t("events.calendar")}
          </span>
          <h2 class="font-black text-3xl md:text-5xl tracking-tight leading-[1.05]">
            {t("events.titlePre")}{" "}
            <span class="text-green">{t("events.titleAccent")}</span>
          </h2>
        </div>

        <div class="border-t-2 border-ink divide-y divide-line py-2">
          {events.map((event, i) => {
            const Tag = event.data.link ? "a" : "div";
            return (
              <Tag
                href={event.data.link}
                target={event.data.link ? "_blank" : undefined}
                rel={event.data.link ? "noopener noreferrer" : undefined}
                class="flex items-center gap-7 py-6 px-4 -mx-4 rounded-xl transition-colors hover:bg-cream"
              >
                <div class="min-w-16 shrink-0">
                  <div
                    class:list={[
                      "font-black text-4xl tracking-tight leading-none",
                      dayColors[i % dayColors.length],
                    ]}
                  >
                    {event.data.date.getDate().toString().padStart(2, "0")}
                  </div>
                  <div class="text-xs font-bold uppercase tracking-wide text-muted mt-0.5">
                    {event.data.date.toLocaleDateString(
                      lang === "it" ? "it-IT" : "en-GB",
                      { month: "short" },
                    )}
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <span
                    class:list={[
                      "inline-block text-[0.65rem] font-bold uppercase tracking-wide px-2.5 py-0.5 rounded-full border-[1.5px] mb-2",
                      tagColors[event.data.tag] ?? defaultTagColor,
                    ]}
                  >
                    {event.data.tag}
                  </span>
                  <div class="font-extrabold text-base tracking-tight mb-1">
                    {event.data.name}
                  </div>
                  <div class="text-xs text-muted">
                    📍 {event.data.location} &nbsp;·&nbsp; {event.data.time}
                  </div>
                </div>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )
}
