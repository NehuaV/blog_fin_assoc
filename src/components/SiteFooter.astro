---
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang } from "../i18n/ui";
import { isLang, useTranslations } from "../i18n/utils";

const lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);

const homeHref = getRelativeLocaleUrl(lang, "");
const blogHref = getRelativeLocaleUrl(lang, "blog");
---

<footer class="bg-ink text-paper pt-12 pb-8">
  <div class="max-w-6xl mx-auto px-6 sm:px-8">
    <div
      class="flex flex-col md:flex-row justify-between gap-12 pb-10 border-b border-white/15 mb-8"
    >
      <div>
        <div class="font-black text-sm tracking-tight mb-2.5">
          Starting Finance Club · <span class="text-pink">USI</span>
        </div>
        <p class="text-xs text-white/40 max-w-50 leading-relaxed">
          {t("footer.tagline")}
        </p>
      </div>
      <div>
        <h4
          class="text-[0.68rem] font-bold tracking-widest uppercase text-white/40 mb-3"
        >
          {t("footer.navigation")}
        </h4>
        <a
          href={homeHref}
          class="block text-sm text-white/70 hover:text-paper transition-colors mb-2"
          >{t("nav.home")}</a
        >
        <a
          href={blogHref}
          class="block text-sm text-white/70 hover:text-paper transition-colors mb-2"
          >{t("nav.blog")}</a
        >
      </div>
    </div>
    <div
      class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-white/40"
    >
      <span
        >© {new Date().getFullYear()} Starting Finance Club USI · Università della
        Svizzera italiana</span
      >
      <div class="flex gap-2.5">
        <a
          href="#"
          class="border border-white/20 rounded-full px-3.5 py-1.5 text-xs font-semibold text-white/70 hover:border-pink hover:text-pink transition-colors"
        >
          Instagram
        </a>
        <a
          href="#"
          class="border border-white/20 rounded-full px-3.5 py-1.5 text-xs font-semibold text-white/70 hover:border-pink hover:text-pink transition-colors"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</footer>
