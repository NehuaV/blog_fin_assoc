---
import { getCollection } from "astro:content";
import BlogPostView from "../../../components/views/BlogPostView.astro";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries
    .filter((entry) => entry.id.startsWith("it/"))
    .map((entry) => ({
      params: { slug: entry.id.slice("it/".length) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
---

<Layout
  title={`${entry.data.title} — Starting Finance Club USI`}
  description={entry.data.description}
  ogImage={entry.data.coverImage.src}
>
  <BlogPostView entry={entry} lang="it" />
</Layout>
