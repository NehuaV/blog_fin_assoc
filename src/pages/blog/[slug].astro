---
import BlogPostView from "../../components/views/BlogPostView.astro";
import Layout from "../../layouts/Layout.astro";
import { getVisibleBlogPosts } from "../../lib/collections";

export async function getStaticPaths() {
  const blogEntries = await getVisibleBlogPosts("en");
  return blogEntries.map((entry) => ({
    params: { slug: entry.id.slice("en/".length) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<Layout
  title={`${entry.data.title} — Starting Finance Club USI`}
  description={entry.data.description}
  ogImage={entry.data.coverImage.src}
  ogType="article"
>
  <BlogPostView entry={entry} lang="en" />
</Layout>
