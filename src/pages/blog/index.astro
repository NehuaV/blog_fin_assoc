---
import { getCollection } from "astro:content";
import BlogIndexView from "../../components/views/BlogIndexView.astro";
import Layout from "../../layouts/Layout.astro";

const allPosts = (await getCollection("blog"))
  .filter((post) => post.id.startsWith("en/"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog — Starting Finance Club USI"
  description="Research, analysis, and insights from USI's Starting Finance Club."
>
  <BlogIndexView posts={allPosts} lang="en" />
</Layout>
