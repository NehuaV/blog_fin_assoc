---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const allPosts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout
  title="Blog — Finance Association USI"
  description="Research, analysis, and insights from USI's Finance Association."
>
  <main class="max-w-5xl mx-auto px-8 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-brand-brass">All posts</p>
    <h1 class="font-display text-4xl text-brand-navy mt-1 mb-12">The Blog</h1>

    <ul class="space-y-12 list-none p-0">
      {allPosts.map(post => (
        <li>
          <a href={`/blog/${post.id}`} class="flex gap-6 group">
            <Image
              src={post.data.coverImage}
              alt={post.data.coverAlt || post.data.title}
              width={200}
              height={134}
              class="zoomable-img rounded object-cover flex-shrink-0 w-[200px] h-[134px]"
            />
            <div>
              <time
                datetime={post.data.pubDate.toISOString()}
                class="font-mono text-xs text-brand-slate"
              >
                {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
              <h2 class="font-display text-2xl text-brand-navy mt-1 mb-2 group-hover:text-brand-brass transition-colors">
                {post.data.title}
              </h2>
              <p class="font-body text-sm text-brand-charcoal">{post.data.description}</p>
              <p class="font-mono text-xs text-brand-slate mt-2">by {post.data.author}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
